    "/client/{token}": {
      "get": {
        "tags": [
          "Client Portal"
        ],
        "summary": "Entry Point Resolver Layar Pembeli",
        "description": "Menentukan layar target yang tepat (schedule / tracking / issue) berdasarkan status FSM paket.",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "description": "Token heksadesimal 64 karakter",
            "schema": {
              "type": "string",
              "example": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rekomendasi layar dan URL redirect",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "screen": {
                      "type": "string",
                      "enum": [
                        "schedule",
                        "tracking",
                        "issue"
                      ],
                      "example": "schedule"
                    },
                    "redirect_url": {
                      "type": "string",
                      "example": "http://localhost:8000/api/client/a1b2c3.../schedule"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Tautan tidak valid atau telah kedaluwarsa"
          }
        }
      }
    },
