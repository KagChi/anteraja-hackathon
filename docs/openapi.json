{
  "openapi": "3.0.3",
  "info": {
    "title": "Anteraja Frozen Logistics API",
    "description": "Dokumentasi OpenAPI / Swagger REST API untuk platform logistik cold chain Anteraja Frozen. Mencakup modul Admin, Kurir, dan Portal Pembeli / Client.",
    "version": "1.0.0",
    "contact": {
      "name": "Anteraja Frozen Engineering Team",
      "url": "https://anteraja.id"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Local Development Server"
    },
    {
      "url": "https://frozen.anteraja.id/api",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Autentikasi sesi staf internal (Admin & Kurir)"
    },
    {
      "name": "Admin - Shipments",
      "description": "Manajemen data pengiriman, alokasi armada, dan penjadwalan"
    },
    {
      "name": "Admin - Exceptions",
      "description": "Penanganan kendala kualitas cold chain dan penetapan putusan admin"
    },
    {
      "name": "Admin - Reports",
      "description": "Monitoring metrik performa & SLA cold chain harian"
    },
    {
      "name": "Admin - History",
      "description": "Audit & arsip riwayat paket terminal"
    },
    {
      "name": "Courier - Tasks",
      "description": "Pengelolaan antrean tugas kurir, estimasi jarak, dan konfirmasi penugasan"
    },
    {
      "name": "Courier - Delivery",
      "description": "Eksekusi perjalanan pengantaran dan pencatatan milestone"
    },
    {
      "name": "Courier - Proof & Issues",
      "description": "Pencatatan bukti serah terima (POD) dan pelaporan insiden lapangan"
    },
    {
      "name": "Courier - Profile",
      "description": "Statistik performa dan riwayat pengantaran kurir"
    },
    {
      "name": "Client Portal",
      "description": "Layanan pelacakan publik pembeli berbasis token, konfirmasi jadwal, & klaim penggantian"
    },
    {
      "name": "Admin - Media",
      "description": "Penyajian berkas media bukti yang tersimpan di disk lokal"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "laravel_session",
        "description": "Autentikasi sesi Laravel untuk staf internal (Admin & Kurir)"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token (Sanctum) untuk pengujian API & integrasi mobile"
      }
    },
    "schemas": {
      "ApiResponseSuccess": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operasi berhasil."
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Terjadi kesalahan pada permintaan."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "dimas@anteraja.id"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "password"
          }
        }
      },
      "StaffUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Dimas Pratama"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "dimas@anteraja.id"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "COURIER"
            ],
            "example": "ADMIN"
          },
          "phone": {
            "type": "string",
            "example": "081299990001"
          }
        }
      },
      "CreateShipmentRequest": {
        "type": "object",
        "required": [
          "buyer_name",
          "buyer_phone",
          "buyer_address",
          "product_name",
          "quantity",
          "scheduled_at",
          "scheduled_end_at"
        ],
        "properties": {
          "buyer_name": {
            "type": "string",
            "example": "Dewi Lestari"
          },
          "buyer_phone": {
            "type": "string",
            "example": "081234567890"
          },
          "buyer_address": {
            "type": "string",
            "example": "Jl. Senopati No. 88, Kebayoran Baru, Jakarta Selatan"
          },
          "product_name": {
            "type": "string",
            "example": "Frozen Wagyu Slice 500g"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-15T08:00:00Z"
          },
          "scheduled_end_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-15T10:00:00Z"
          },
          "service_type": {
            "type": "string",
            "enum": [
              "REGULER",
              "INSTANT_FROZEN"
            ],
            "default": "REGULER"
          },
          "handling_notes": {
            "type": "string",
            "example": "Jaga di suhu -18°C"
          }
        }
      },
      "AssignCourierRequest": {
        "type": "object",
        "required": [
          "courier_id"
        ],
        "properties": {
          "courier_id": {
            "type": "integer",
            "example": 2
          },
          "cooler_box_code": {
            "type": "string",
            "example": "BOX-FROZEN-04"
          }
        }
      },
      "RescheduleShipmentRequest": {
        "type": "object",
        "required": [
          "scheduled_at",
          "scheduled_end_at"
        ],
        "properties": {
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-16T08:00:00Z"
          },
          "scheduled_end_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-16T10:00:00Z"
          },
          "admin_note": {
            "type": "string",
            "example": "Dijadwalkan ulang sesuai konfirmasi pembeli."
          }
        }
      },
      "ResolveDecisionRequest": {
        "type": "object",
        "required": [
          "decision",
          "reason"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "PROCEED",
              "RECHECK",
              "RETURN",
              "RESEND",
              "RESCHEDULE"
            ],
            "example": "RETURN"
          },
          "reason": {
            "type": "string",
            "example": "Retur ke gudang karena kemasan luar rusak parah."
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "description": "Wajib jika decision=RESCHEDULE / RESEND"
          },
          "scheduled_end_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CourierDistanceRequest": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "float",
            "example": -6.229746
          },
          "longitude": {
            "type": "number",
            "format": "float",
            "example": 106.848529
          }
        }
      },
      "CourierRejectRequest": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "example": "Kapasitas cooler box motor sudah penuh."
          }
        }
      },
      "CourierDepartRequest": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "string",
            "example": "Berangkat dari Hub Tebet."
          }
        }
      },
      "CourierArriveRequest": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "float",
            "example": -6.2301
          },
          "longitude": {
            "type": "number",
            "format": "float",
            "example": 106.8492
          }
        }
      },
      "CourierStoreProofRequest": {
        "type": "object",
        "required": [
          "photo",
          "temperature_c",
          "recipient_type"
        ],
        "properties": {
          "photo": {
            "type": "string",
            "format": "binary",
            "description": "File foto bukti serah terima (JPEG/PNG/WEBP, maks 5MB)"
          },
          "temperature_c": {
            "type": "number",
            "format": "float",
            "example": -18.5
          },
          "recipient_type": {
            "type": "string",
            "enum": [
              "BUYER",
              "REPRESENTATIVE"
            ],
            "example": "BUYER"
          },
          "recipient_name": {
            "type": "string",
            "example": "Rina Putri"
          },
          "recipient_relation": {
            "type": "string",
            "enum": [
              "SELF",
              "FAMILY",
              "SECURITY",
              "COLLEAGUE"
            ],
            "example": "SELF"
          },
          "notes": {
            "type": "string",
            "example": "Paket diterima langsung dalam kondisi beku sempurna."
          }
        }
      },
      "CourierStoreIssueRequest": {
        "type": "object",
        "required": [
          "issue_category",
          "description",
          "temperature_c"
        ],
        "properties": {
          "photo": {
            "type": "string",
            "format": "binary",
            "description": "Foto kendala fisik / kemasan (Opsional, maks 5MB)"
          },
          "issue_category": {
            "type": "string",
            "enum": [
              "KEMASAN_BOCOR",
              "KEMASAN_BASAH",
              "SUHU_NAIK",
              "PEMBELI_TIDAK_ADA",
              "ALAMAT_TIDAK_DITEMUKAN",
              "COD_DITOLAK"
            ],
            "example": "SUHU_NAIK"
          },
          "description": {
            "type": "string",
            "example": "Suhu terukur -8°C karena kendala ice gel bocor."
          },
          "temperature_c": {
            "type": "number",
            "format": "float",
            "example": -8.0
          }
        }
      },
      "ClientConfirmScheduleRequest": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "string",
            "example": "Saya siap menerima paket di jam tersebut."
          }
        }
      },
      "ClientRescheduleRequest": {
        "type": "object",
        "required": [
          "date",
          "slot"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-10-16"
          },
          "slot": {
            "type": "string",
            "enum": [
              "08:00-10:00",
              "10:00-12:00",
              "13:00-15:00",
              "15:00-17:00"
            ],
            "example": "13:00-15:00"
          },
          "reason": {
            "type": "string",
            "example": "Sedang di luar rumah pada pagi hari."
          }
        }
      },
      "ClientReplacementRequest": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "string",
            "example": "Mohon pastikan tiba sebelum jam 12 siang."
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login Staf (Admin / Kurir)",
        "description": "Mengautentikasi staf dan menghasilkan cookie sesi HTTP-only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Login berhasil."
                    },
                    "user": {
                      "$ref": "#/components/schemas/StaffUser"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Kredensial tidak valid"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout Staf",
        "description": "Menghapus sesi login staf yang sedang aktif.",
        "responses": {
          "200": {
            "description": "Logout berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSuccess"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Cek Profil Sesi Staf",
        "description": "Mengembalikan data staf yang saat ini sedang terautentikasi.",
        "responses": {
          "200": {
            "description": "Data profil aktif",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/StaffUser"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Belum terautentikasi"
          }
        }
      }
    },
    "/media/preview": {
      "get": {
        "tags": [
          "Admin - Media"
        ],
        "summary": "Pratinjau Foto Bukti",
        "description": "Menyajikan foto bukti penyerahan atau kendala yang tersimpan di disk lokal. Disk lokal tidak mendukung temporary URL, sehingga MediaStorage menyerahkan URL rute ini untuk setiap foto tersimpan.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "Path relatif media yang ditulis MediaStorage, mis. proofs/2026/10/01H....jpg",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berkas gambar",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Belum terautentikasi"
          },
          "404": {
            "description": "Path tidak dikenal atau berkas tidak ada"
          }
        }
      }
    },
    "/admin/shipments": {
      "get": {
        "tags": [
          "Admin - Shipments"
        ],
        "summary": "Daftar Pengiriman (Shipments Index)",
        "description": "Mengambil daftar pengiriman dengan opsi pencarian, filter status, filter kurir, dan pagination.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Pencarian resi / nama pembeli / kurir",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
      "description": "Filter status paket, memakai kode status (mis. CONFIRMED, IN_DELIVERY, ISSUE_REPORTED)",
            "schema": {
              "type": "string",
              "enum": [
                "issue",
                "transit",
                "waiting",
                "delivered",
                "scheduled"
              ]
            }
          },
          {
            "name": "courier",
            "in": "query",
            "description": "Filter kurir (nama atau unassigned)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "schedule",
            "in": "query",
            "description": "Filter rentang waktu jadwal",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "tomorrow",
                "all"
              ],
              "default": "today"
            }
          },
    {
      "name": "date",
      "in": "query",
      "description": "Filter satu hari pengiriman (Y-m-d). Bila diisi, menggantikan filter schedule.",
      "schema": {
        "type": "string",
        "format": "date"
      }
    },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar pengiriman",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "shipments": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Admin - Shipments"
        ],
        "summary": "Buat Pengiriman Baru",
        "description": "Menambahkan paket cold chain baru dengan status awal AWAITING_CONFIRMATION.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShipmentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Paket berhasil dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Paket berhasil dibuat."
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validasi gagal"
          }
        }
      }
    },
    "/admin/shipments/create": {
      "get": {
        "tags": [
          "Admin - Shipments"
        ],
        "summary": "Data Master Form Pembuatan Paket",
        "description": "Mengambil master produk, pembeli, dan opsi jadwal untuk form admin.",
        "responses": {
          "200": {
            "description": "Data master pembuatan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/admin/shipments/export": {
      "get": {
        "tags": [
          "Admin - Shipments"
        ],
        "summary": "Ekspor CSV Pengiriman",
        "description": "Menghasilkan stream file CSV daftar pengiriman dengan proteksi CSV Formula Injection.",
        "responses": {
          "200": {
            "description": "File stream CSV",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/admin/shipments/{tracking_number}": {
      "get": {
        "tags": [
          "Admin - Shipments"
        ],
        "summary": "Detail Pengiriman",
        "description": "Mengambil detail lengkap paket, riwayat cold chain, dan log status audit.",
        "parameters": [
          {
            "name": "tracking_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AJ-FRZ-0012345"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detail paket",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Paket tidak ditemukan"
          }
        }
      }
    },
    "/admin/shipments/{tracking_number}/assign": {
      "post": {
        "tags": [
          "Admin - Shipments"
        ],
        "summary": "Tugaskan Kurir & Cooler Box",
        "description": "Menugaskan kurir aktif dan mengalokasikan kode cooler box pendingin (FSM -> COURIER_ASSIGNED).",
        "parameters": [
          {
            "name": "tracking_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AJ-FRZ-0012345"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignCourierRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Penugasan berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSuccess"
                }
              }
            }
          },
          "422": {
            "description": "Status paket tidak dapat ditugaskan"
          }
        }
      }
    },
    "/admin/shipments/{tracking_number}/reschedule": {
      "post": {
        "tags": [
          "Admin - Shipments"
        ],
        "summary": "Jadwalkan Ulang Pengiriman",
        "description": "Memperbarui jadwal tanggal dan slot jam pengiriman oleh admin.",
        "parameters": [
          {
            "name": "tracking_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AJ-FRZ-0012345"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RescheduleShipmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Jadwal berhasil diperbarui",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSuccess"
                }
              }
            }
          }
        }
      }
    },
    "/admin/exceptions": {
      "get": {
        "tags": [
          "Admin - Exceptions"
        ],
        "summary": "Daftar Kendala Cold Chain Aktif",
        "description": "Mengambil daftar paket yang dilaporkan mengalami insiden kualitas/suhu yang belum diputus.",
        "responses": {
          "200": {
            "description": "Daftar kendala",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/admin/exceptions/{tracking_number}": {
      "get": {
        "tags": [
          "Admin - Exceptions"
        ],
        "summary": "Detail Kendala & Pemeriksaan Kualitas",
        "description": "Mengambil detail laporan kendala lapangan, foto bukti insiden via signed URL, dan opsi putusan.",
        "parameters": [
          {
            "name": "tracking_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AJ-FRZ-0012345"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detail kendala",
            "content": {
