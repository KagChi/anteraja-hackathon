# =============================================================================
# Anteraja Frozen - Production Environment Configuration
# =============================================================================

APP_NAME="Anteraja Frozen"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
# Waktu disimpan dalam UTC dan ditampilkan sebagai WIB oleh DisplayTime.
# Jangan diganti ke Asia/Jakarta: nilai ini juga menyetel zona sesi database.
APP_TIMEZONE="UTC"
APP_URL=https://frozen.madgo.my.id
ASSET_URL=https://frozen.madgo.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=anteraja_frozen
DB_USERNAME=anteraja
DB_PASSWORD=change_this_strong_password_123

# --- Cache, Session, Queue (Redis) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=anteraja_cache_

QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Octane / FrankenPHP ---
OCTANE_SERVER=frankenphp
OCTANE_PORT=80
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500
OCTANE_HTTPS=false

# --- Automatic Startup Tasks ---
RUN_MIGRATIONS=true
RUN_SEEDS=true
