# Template for the Android shell builds. `scripts/build-apk.sh <kurir|client>`
# fills in the placeholders below from mobile/apps.php, installs the result as
# .env for the duration of the build, then puts your development .env back.
#
# The shipped app boots an embedded PHP runtime, so nothing here may point at
# services the phone cannot reach: the web, database and queue drivers are all
# on-device. The web view itself talks to MOBILE_WEB_BASE_URL over the network.

APP_NAME="__APP_NAME__"
APP_ENV=local
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

MOBILE_APP=__MOBILE_APP__
MOBILE_WEB_BASE_URL=__WEB_BASE_URL__

NATIVEPHP_APP_ID=__APP_ID__
NATIVEPHP_APP_VERSION=__APP_VERSION__
NATIVEPHP_APP_VERSION_CODE=__APP_VERSION_CODE__
# The native screen in routes/mobile.php. Its web view loads the deployed site,
# which keeps navigation inside the app; the legacy web view would hand
# external links to the system browser instead.
NATIVEPHP_START_URL=/shell

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
DB_CONNECTION=sqlite

LOG_CHANNEL=stack
LOG_LEVEL=error
