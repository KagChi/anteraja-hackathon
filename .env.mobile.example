# Template for the Android shell builds. `scripts/build-apk.sh <app>` fills in
# the placeholders below from mobile/apps.php, installs the result as .env for
# the duration of the build, then puts your development .env back.
#
# The screens are native UI (NativeComponent + EDGE elements), so the shipped
# app opens no web view: it talks to the backend over HTTPS instead, using the
# MOBILE_API_BASE_URL below.

APP_NAME="__APP_NAME__"
APP_ENV=local
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

MOBILE_APP=__MOBILE_APP__

# Backend the app talks to over HTTPS. Stamped from MOBILE_API_BASE_URL at
# build time; the default is the hackathon deployment.
MOBILE_API_BASE_URL=__API_BASE_URL__

NATIVEPHP_APP_ID=__APP_ID__
NATIVEPHP_APP_VERSION=__APP_VERSION__
NATIVEPHP_APP_VERSION_CODE=__APP_VERSION_CODE__
# The first native screen the app opens on. Every other screen in
# routes/mobile.php is reached by navigating from there.
NATIVEPHP_START_URL=__START_URL__

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
DB_CONNECTION=sqlite

LOG_CHANNEL=stack
LOG_LEVEL=error
